<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="ARM.Themes.LightTheme">

    <!-- Tema Chiaro: bianco e grigi, accento quasi nero (ARM 3.0). I significati dei colori sono gli stessi in tutti i temi. -->
    <Color x:Key="BgColor">#F5F5F6</Color>
    <Color x:Key="TabBgColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#111113</Color>
    <Color x:Key="SubTextColor">#5E5E66</Color>
    <Color x:Key="AccentColor">#111113</Color>
    <Color x:Key="Accent2Color">#B42318</Color>
    <Color x:Key="Accent3Color">#111113</Color>
    <Color x:Key="Accent4Color">#B7791F</Color>
    <Color x:Key="Accent5Color">#2F6FE0</Color>
    <Color x:Key="SoftAccentColor">#EFEFF1</Color>
    <Color x:Key="BorderColor">#E4E4E7</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="ShadowColor">#111113</Color>

    <!-- Valori derivati del design -->
    <Color x:Key="FieldBgColor">#EFEFF1</Color>
    <Color x:Key="CardBorderColor">#E4E4E7</Color>
    <Color x:Key="Hero1Color">#EFEFF1</Color>
    <Color x:Key="Hero2Color">#FFFFFF</Color>
    <Color x:Key="OnHeroColor">#111113</Color>
    <Color x:Key="MiniBgColor">#FFFFFF</Color>
    <Color x:Key="MiniTextColor">#111113</Color>
    <Color x:Key="MiniBorderColor">#E4E4E7</Color>
    <Color x:Key="SwitchOffColor">#CFCFD4</Color>
    <Color x:Key="FabShadowColor">#111113</Color>

    <!-- 3.0: superficie rialzata, bordo forte, rosso tenue (solo ritardi), punti categoria -->
    <Color x:Key="SurfaceRaisedColor">#EFEFF1</Color>
    <Color x:Key="BorderStrongColor">#CFCFD4</Color>
    <Color x:Key="WarnColor">#B42318</Color>
    <Color x:Key="Cat1">#2F6FE0</Color>
    <Color x:Key="Cat2">#B7791F</Color>
    <Color x:Key="Cat3">#7A5AD1</Color>
    <Color x:Key="Cat4">#178F82</Color>
    <Color x:Key="Cat5">#C24E7A</Color>

    <!-- Fondi delle note (3.0: neutri; il colore della nota diventa un punto) -->
    <Color x:Key="Pastel1">#FFFFFF</Color>
    <Color x:Key="Pastel2">#FFFFFF</Color>
    <Color x:Key="Pastel3">#FFFFFF</Color>
    <Color x:Key="Pastel4">#FFFFFF</Color>
    <Color x:Key="Pastel5">#FFFFFF</Color>
    <Color x:Key="Pastel6">#FFFFFF</Color>

    <x:Double x:Key="SoftAlpha">0.12</x:Double>
    <x:Double x:Key="ShadowOpacity">0.0</x:Double>
    <x:Double x:Key="FabShadowOpacity">0.18</x:Double>
</ResourceDictionary>
