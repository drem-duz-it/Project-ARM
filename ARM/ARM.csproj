<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ARM</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<NoWarn>$(NoWarn);CS0618;CS8632;XC0022;XC0025;MVVMTK0045</NoWarn>

		<!-- Info applicazione -->
		<ApplicationTitle>ARM</ApplicationTitle>
		<ApplicationId>com.companyname.armusic</ApplicationId>
		<ApplicationDisplayVersion>3.0</ApplicationDisplayVersion>
		<ApplicationVersion>12</ApplicationVersion>

		<!-- Windows: avvio diretto dell'exe (profilo "Windows Machine") -->
		<WindowsPackageType>None</WindowsPackageType>
		<!-- Nome dei file compilati (es. ARM.exe su Windows) -->
		<AssemblyName>ARM</AssemblyName>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon: logo ARM (X rosa) su sfondo scuro -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.72" />

		<!-- Splash Screen: logo su sfondo chiaro, come il tema -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F6F5FB" BaseSize="160,160" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Traduzioni (vedi docs/LOCALIZATION.md): il nome logico è il file stesso, es. en.json -->
		<EmbeddedResource Include="Localization\*.json" LogicalName="%(Filename)%(Extension)" />

	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
		<!-- 3.0: lettura delle email di Amazon da Gmail (IMAP), solo sul PC -->
		<PackageReference Include="MailKit" Version="4.18.2" Condition="$(TargetFramework.Contains('-windows'))" />
		<PackageReference Include="YoutubeExplode" Version="6.6.3" />
	</ItemGroup>

</Project>
